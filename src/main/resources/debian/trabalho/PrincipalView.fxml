<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="debian.trabalho.PrincipalController">
   <children>
      <Button layoutX="236.0" layoutY="313.0" mnemonicParsing="false" onAction="#conectar" text="Conectar">
         <font>
            <Font size="23.0" />
         </font>
      </Button>
      <Label layoutX="212.0" layoutY="14.0" text="Locadora 2B">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <VBox layoutX="78.0" layoutY="74.0" prefHeight="223.0" prefWidth="444.0">
         <children>
            <Label text="URL">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <TextField fx:id="urlTextField" promptText="jdbc:postgresql://localhost:5432/Locadora2B" text="jdbc:postgresql://localhost:5432/Locadora2B">
               <font>
                  <Font size="17.0" />
               </font>
            </TextField>
            <Label text="Username">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <TextField fx:id="usernameTextField" promptText="postgres" text="postgres">
               <font>
                  <Font size="17.0" />
               </font>
            </TextField>
            <Label text="Password">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <TextField fx:id="passwordTextField" promptText="root" text="root">
               <font>
                  <Font size="17.0" />
               </font>
            </TextField>
         </children>
      </VBox>
   </children>
</AnchorPane>
