<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="debian.trabalho.AluguelController">
   <children>
      <Label layoutX="190.0" layoutY="14.0" text="Cadastrar Aluguel">
         <font>
            <Font size="26.0" />
         </font>
      </Label>
      <VBox layoutX="34.0" layoutY="66.0" prefHeight="274.0" prefWidth="532.0">
         <children>
            <Label text="Dia Inicial:" />
            <TextField fx:id="diaInicialTextField" />
            <Label text="Dia Final:" />
            <TextField fx:id="diaFinalTextField" />
            <Label text="Quilometragem Inicial:" />
            <TextField fx:id="quilometragemITextField" />
            <Label text="Quilometragem Final:" />
            <TextField fx:id="quilometragemFTextField" />
            <Label text="ID Carro:" />
            <TextField fx:id="idCarroTextField" />
            <Label text="ID Cliente:" />
            <TextField fx:id="idClienteTextField" />
         </children></VBox>
      <Button layoutX="252.0" layoutY="340.0" mnemonicParsing="false" onAction="#cadastrarAluguel" text="Cadastrar">
         <font>
            <Font size="16.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
